{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "cd ../.. && npm install",
  "ignoreCommand": "npx turbo-ignore provider-portal",
  "crons": [
    {
      "path": "/api/cron/collect-metrics",
      "schedule": "*/15 * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "live": true
    }
  }
}
